{
  "name": "lst-local-subtitle-translate",
  "version": "0.6.7",
  "private": true,
  "description": "Release tooling for the LST browser extension.",
  "scripts": {
    "check:syntax": "node scripts/check-syntax.mjs",
    "version:set": "node scripts/set-version.mjs",
    "prepare:chrome": "node scripts/prepare-chrome.mjs",
    "build:chrome": "npm run prepare:chrome && web-ext build --source-dir=.chrome-build --artifacts-dir=web-ext-artifacts --overwrite-dest --filename=lst-chrome-{version}.zip",
    "verify:chrome": "node scripts/verify-package.mjs chrome",
    "package:chrome": "npm run check && npm run build:chrome && npm run verify:chrome",
    "dev:firefox": "npm run prepare:firefox && web-ext run --source-dir=.firefox-build",
    "dev:chrome": "npm run prepare:chrome",
    "test:cache": "node tests/test-cache.mjs",
    "test:episode-identity": "node tests/test-episode-identity.mjs",
    "test:page-hook": "node tests/test-page-hook.mjs",
    "test:playback-site": "node tests/test-playback-site.mjs",
    "test:playback-policy": "node tests/test-playback-policy.mjs",
    "test:settings-schema": "node tests/test-settings-schema.mjs",
    "test:providers": "node tests/test-providers.mjs",
    "test:translation-context": "node tests/test-translation-context.mjs",
    "test:translation-coordinator": "node tests/test-translation-coordinator.mjs",
    "test:subtitle-parser": "node tests/test-subtitle-parser.mjs",
    "test:session-lifecycle": "node tests/test-session-lifecycle.mjs",
    "test:captured-track-lifecycle": "node tests/test-captured-track-lifecycle.mjs",
    "test:subtitle-sync": "node tests/test-subtitle-sync.mjs",
    "test:translation-guard": "node tests/test-translation-guard.mjs",
    "test:translation-verification": "node tests/test-translation-verification.mjs",
    "test:setup-page": "node tests/test-setup-page.mjs",
    "test:subtitle-import": "node tests/test-subtitle-import.mjs",
    "test:structured-response": "node tests/test-structured-response.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepare:firefox": "node scripts/prepare-firefox.mjs",
    "lint": "npm run prepare:firefox && web-ext lint --source-dir=.firefox-build",
    "check": "npm run check:syntax && npm run test:settings-schema && npm run test:cache && npm run test:episode-identity && npm run test:page-hook && npm run test:playback-site && npm run test:playback-policy && npm run test:providers && npm run test:translation-context && npm run test:translation-coordinator && npm run test:subtitle-parser && npm run test:session-lifecycle && npm run test:captured-track-lifecycle && npm run test:subtitle-sync && npm run test:translation-guard && npm run test:translation-verification && npm run test:structured-response && npm run test:setup-page && npm run test:subtitle-import && npm run check:release && npm run lint",
    "build:firefox": "npm run prepare:firefox && web-ext build --source-dir=.firefox-build --artifacts-dir=web-ext-artifacts --overwrite-dest --filename=lst-firefox-{version}.zip",
    "build": "npm run build:firefox",
    "verify:firefox": "node scripts/verify-package.mjs firefox",
    "verify:package": "npm run verify:firefox",
    "package:firefox": "npm run check && npm run build:firefox && npm run verify:firefox",
    "package": "npm run package:firefox",
    "package:all": "npm run check && npm run build:firefox && npm run verify:firefox && npm run build:chrome && npm run verify:chrome",
    "sign:amo": "npm run prepare:firefox && web-ext sign --source-dir=.firefox-build --artifacts-dir=web-ext-artifacts --channel=listed --amo-metadata=amo-metadata.json --approval-timeout=0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "web-ext": "10.6.0"
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "web-ext-artifacts",
    "ignoreFiles": [
      ".github/**",
      ".gitignore",
      "docs/**",
      "PRIVACY.md",
      "README.md",
      "amo-metadata.json",
      "package.json",
      "package-lock.json",
      "lst-local-subtitle-translate",
      "scripts",
      "web-ext-artifacts/**",
      "tests/**"
    ]
  }
}
