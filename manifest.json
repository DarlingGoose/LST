{
  "manifest_version": 3,
  "name": "LST — Local Subtitle Translate",
  "version": "0.3.0",
  "description": "Translate Netflix subtitles locally with Ollama, with realtime translation, precompute, diagnostics, local caching, and a pinned debug panel.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LST — Local Subtitle Translate"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lst-local-subtitle-translate@local.dev",
      "strict_min_version": "128.0"
    }
  },
  "short_name": "LST"
}
